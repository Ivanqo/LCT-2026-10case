COMPOSE_PROJECT_NAME=docaibuild

# Public domain and TLS
ROOT_DOMAIN=docaibuild.ru
LANDING_DOMAIN=landing.docaibuild.ru
APP_DOMAIN=app.docaibuild.ru
CERT_NAME=docaibuild.ru
LETSENCRYPT_EMAIL=admin@docaibuild.ru
CLIENT_MAX_BODY_SIZE=100m

# Bind internal service ports only to localhost on the VPS.
DOCKER_BIND_IP=127.0.0.1
API_HOST_PORT=8000
GATEWAY_HOST_PORT=8080
RAG_HOST_PORT=8001
IFC_HOST_PORT=8002
FRONTEND_HOST_PORT=3000
REACT_FRONTEND_HOST_PORT=3100
# Optional build-time override for the React app's API base (default: same host, GATEWAY_HOST_PORT, resolved at runtime).
REACT_FRONTEND_API_BASE=
LANDING_HOST_PORT=3001
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672

# Production CORS
CORS_ORIGINS=https://app.docaibuild.ru
ENABLE_METRICS=true

# Initial admin account. Change before first production start.
DEFAULT_ADMIN_LOGIN=admin
DEFAULT_ADMIN_EMAIL=admin@docaibuild.ru
DEFAULT_ADMIN_ORG=DocAI Build
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DEFAULT_ADMIN_API_KEY=CHANGE_ME_STRONG_API_KEY

# Database
POSTGRES_DB=ifcdb
POSTGRES_USER=ifc
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# RAG/OCR tuning
RAG_ENABLE_OCR=1
RAG_MAX_PAGES=0
ENABLE_OPTIONAL_OCR=false
OCR_LANG=rus+eng

# CASE10 RabbitMQ worker
CASE10_JOB_MAX_ATTEMPTS=3
CASE10_JOB_STALE_SECONDS=900
CASE10_WORKER_RECONNECT_SECONDS=5

# Landing integrations
LANDING_BRAND=DocAI Build
LANDING_YOUTUBE=
LANDING_MP4=
LANDING_RATE_LIMIT_MAX=5
LANDING_RATE_LIMIT_WINDOW_SEC=900
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
