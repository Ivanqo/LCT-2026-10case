# CASE10 stand settings. Copy to `.env` in the repository root (bootstrap.sh does it and fills the secrets).

# --- demo account (created on first start; change before exposing the stand) ---
CASE10_ADMIN_LOGIN=admin
CASE10_ADMIN_PASSWORD=Case10-Demo-2026
CASE10_ADMIN_EMAIL=admin@case10.local
CASE10_ADMIN_ORG=Мосгосстройнадзор (демо)
# API key for integrations (X-API-Key header); empty = generated and written to /data/initial_admin_credentials.txt
CASE10_ADMIN_API_KEY=

# --- ports (bound to DOCKER_BIND_IP; behind nginx keep 127.0.0.1) ---
DOCKER_BIND_IP=127.0.0.1
API_HOST_PORT=8000
GATEWAY_HOST_PORT=8080
UI_HOST_PORT=3100

# --- public stand (deploy/case10/docker-compose.stand.yml) ---
APP_DOMAIN=case10.example.ru
LETSENCRYPT_EMAIL=
# The UI calls the API on its own origin behind nginx:
REACT_FRONTEND_API_BASE=
CORS_ORIGINS=*

# --- server-side packages for POST /api/case10/batch-runs ---
CASE10_PACKAGES_DIR=./packages

# --- compute ---
# 0 = all CPUs the container may use (docker --cpus / cgroup quota aware), capped by MAX_WORKERS
CASE10_LIVE_TAGGER_WORKERS=0
CASE10_LIVE_TAGGER_MAX_WORKERS=24
CASE10_LIVE_TAGGER_CACHE_ENABLED=1
CASE10_PARAMETER_CODE_STYLE=matrix11
CASE10_LIVE_TAGGER_CACHE_DIR=/data/live_tagger_cache
# Keep both extraction caches on the case10_data volume. Experimental extractors stay off until their
# end-to-end A/B acceptance criteria are met.
CASE10_EXPLICATION_COMPARE=0
CASE10_ROOM_DRAWING_COMPARE_ENABLED=0
CASE10_EXPLICATION_CACHE_DIR=/data/live_tagger_cache/explication
# GPU: add -f docker-compose.case10.gpu.yml; share of GPU memory the service may take
CASE10_GPU_MEMORY_FRACTION=0.2
# Optional local LLM candidate verifier (Qwen3-4B): off in the delivery, weights are not in the image
CASE10_LLM_VERIFIER_ENABLED=0
