# CASE10 stand, plain HTTP (first start, before a certificate exists, or an internal network without TLS).
# UI at /, the external API contract (node gateway) at /api/ and /openapi.json.
server {
    listen 80;
    server_name ${APP_DOMAIN} _;
    charset utf-8;
    client_max_body_size 200m;   # UI uploads (ТЗ 9.1: 50 MB per file / 200 MB per package); big packages go server-side

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location ~ ^/(api/|openapi\.json|health) {
        proxy_pass http://node_gateway:8080;
        proxy_http_version 1.1;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://react_frontend:80;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
