                  "scope_key": {
                    "type": "string"
                  },
                  "document_version_id": {
                    "type": "integer"
                  },
                  "justification": {
                    "type": "string",
                    "minLength": 3
                  }
                },
                "required": [
                  "scope_key",
                  "document_version_id",
                  "justification"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Choice + effect + scopes"
