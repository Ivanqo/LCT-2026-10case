          }
        }
      }
    },
    "/api/case10/processes/{process_id}/revision-choices": {
      "post": {
        "summary": "S5/S3: inspector chooses the authoritative edition with a justification (new version)",
        "parameters": [
          {
            "name": "process_id",
            "in": "path",
            "required": true,
            "schema": {
