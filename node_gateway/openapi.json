  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "parameters": {
      "ProjectId": {
        "name": "project_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer"
        }
      },
      "ProjectIdQuery": {
        "name": "project_id",
        "in": "query",
        "required": true,
        "schema": {
          "type": "integer"
        }
      },
      "ProcessId": {
        "name": "process_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "ProtocolId": {
        "name": "protocol_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer"
        }
      },
      "EvidenceGroupId": {
        "name": "evidence_group_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer"
        }
      },
      "FragmentId": {
        "name": "fragment_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer"
        }
      }
    },
    "responses": {
      "PythonError": {
        "description": "HTTP error body forwarded from Python API",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": [
          "login",
          "password"
        ],
        "properties": {
          "login": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        }
      },
      "ProjectCreate": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "OfficialDatasetImportRequest": {
        "type": "object",
        "properties": {
          "object_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "include_hidden": {
            "type": "boolean",
            "default": false
          },
          "include_pages": {
            "type": "boolean",
            "default": true
          },
          "include_annotations": {
            "type": "boolean",
            "default": true
          },
          "include_gold": {
            "type": "boolean",
            "default": true
          },
          "allow_hidden_gold_labels": {
            "type": "boolean",
            "default": false
          },
          "run_processes": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "ProcessCreateRequest": {
        "type": "object",
        "properties": {
          "object_id": {
            "type": "string",
            "nullable": true
          },
          "run_immediately": {
            "type": "boolean",
            "default": true,
            "description": "When true, the API enqueues a RabbitMQ worker job and returns before heavy processing starts."
          },
          "affected_param_codes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "matrix_version": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "EvidenceDecisionRequest": {
        "type": "object",
        "required": [
          "decision"
        ],
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "Confirm",
              "Reject",
              "Clarification Required"
            ]
          },
          "reason_code": {
            "type": "string",
            "nullable": true
          },
          "comment": {
            "type": "string",
            "nullable": true
          },
          "ui_metrics": {
            "type": "object",
            "description": "S5: {actions, elapsed_ms, via} measured by the workbench; audit only"
          }
        }
      },
      "MatrixResponse": {
        "type": "object",
        "required": [
          "matrix",
          "params"
        ],
        "properties": {
          "matrix": {
            "type": "object",
            "properties": {
              "version": {
                "type": "string"
              },
              "params_count": {
                "type": "integer",
                "example": 132
              }
            }
          },
          "params": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "detail": {}
        }
      }
    }
  }
}
